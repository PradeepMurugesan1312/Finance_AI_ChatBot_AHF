# Copy to .env for local development. .env is git-ignored.
# On Cloud Foundry these come from manifest.yml `env:` and bound services,
# NOT from a .env file.

# --- Server ----------------------------------------------------------------
APP_ENV=dev
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=INFO
# Log raw user message text (off by default — treated as potentially sensitive).
LOG_MESSAGE_TEXT=false
# Pin the agent-card URL for local runs behind a tunnel (optional).
# PUBLIC_URL=https://finance-ai-chatbot.cfapps.us10-001.hana.ondemand.com

# --- step 2: SAP Generative AI Hub / AI Core (GPT 5.2) -------------------
MODEL_NAME=gpt-5.2
LLM_DEPLOYMENT_ID=dcc9a836b894dc1d
AICORE_RESOURCE_GROUP=default
AICORE_DESTINATION_NAME=GENAICORE
# GPT deployments proxy to Azure OpenAI and need an api-version query param.
# Optional — leave unset to use the code default (new enough for tool calling).
# Must be >= 2023-12-01-preview or `tools` requests 400.
# AICORE_API_VERSION=2024-10-21
# GPT 5.2 is reasoning-tier: sent as `max_completion_tokens`, not `max_tokens`.
LLM_MAX_COMPLETION_TOKENS=4096
LLM_TIMEOUT_SECONDS=45

# --- step 3: S/4HANA (read-only OData) ----------------------------------
S4HANA_DESTINATION_NAME=S43
# OData service root, prepended to every service path so the S43 destination
# URL can be the bare host:port. Default is the SAP Gateway standard below;
# set to "" if the destination URL already includes it.
# S4HANA_ODATA_BASE_PATH=/sap/opu/odata/sap
S4HANA_TIMEOUT_SECONDS=20
# Max GPT 5.2 <-> S/4HANA tool round trips per turn before a final answer is forced.
S4HANA_MAX_TOOL_ITERATIONS=4

# --- Local dev only: paste service keys so destinations resolve off-platform.
#   cf create-service-key destination-service dev-key && cf service-key destination-service dev-key
# DESTINATION_SERVICE_KEY={"uri":"https://...","clientid":"...","clientsecret":"...","url":"https://..."}
# CONNECTIVITY_SERVICE_KEY={"onpremise_proxy_host":"...","onpremise_proxy_port":"...","clientid":"...","clientsecret":"...","token_service_url":"https://..."}

# --- step 4: RAG policy knowledge base -------------------------------
KB_BACKEND=local                       # "local" (JSON vector index) | "hana" (stub)
KB_INDEX_PATH=knowledge_base/index.json # git-ignored; built by kb_ingest / on startup
KB_DOCS_DIR=knowledge_base/docs         # approved policy .md / .txt files live here
KB_MIN_SCORE=0.20                       # min top-hit similarity to count as grounded (raise to ~0.75 with real embeddings)
KB_TOP_K=4
KB_SNIPPET_CHARS=700                    # max chars of a passage handed back per hit
# Rebuild the index from KB_DOCS_DIR on startup. Always rebuilt when the index
# file is missing; set true to force it (e.g. after enabling AI Core embeddings).
KB_REBUILD_ON_START=false
# Set to embed via SAP AI Core (text-embedding-3-small) instead of the local
# fallback embedding. Requires GENAICORE to resolve; re-run kb_ingest after
# changing this so the index matches the query-time embedding.
# EMBEDDING_DEPLOYMENT_ID=
# EMBEDDING_MODEL_NAME=text-embedding-3-small

# --- step 5 / 7: task persistence -----------------------------------
# TASK_STORE_PATH=/home/vcap/app/data/tasks.db
# EMIT_WORKING_EVENT=false

# --- step 9: observability -----------------------------------------
# INTERACTION_LOG_PATH=/home/vcap/app/data/interactions.jsonl
# FEEDBACK_LOG_PATH=/home/vcap/app/data/feedback.jsonl
